file(MAKE_DIRECTORY "${WORK}/docs/results")
set(record [=[{"tests":[{"test":"mac → pi","seconds":1,"values":[{"name":"latency","value":2.5,"unit":"ms"}]}]}]=])
file(WRITE "${WORK}/docs/results/sample.json" "${record}")
set(markers [=[% results: sample [layout={compact},columns={test|latency},headers={Pair|Latency},widths={0.4|0.4}]
% /results
% results: sample [layout={compact},columns={test|latency},strip-prefix={mac|→}]
% /results
% results: sample [layout={transpose},columns={latency},header={Measured}]
% /results
]=])
file(WRITE "${WORK}/table.tex" "${markers}")
set(sync_pages table.tex)
function(sync expected)
    set(only_pages "")
    foreach(page IN LISTS sync_pages)
        list(APPEND only_pages --only "${page}")
    endforeach()
    execute_process(COMMAND "${TOOL}" --root "${WORK}" ${only_pages} ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "pass" AND NOT status EQUAL 0)
        message(FATAL_ERROR "docs-sync failed: ${output}${error}")
    elseif(expected STREQUAL "fail" AND status EQUAL 0)
        message(FATAL_ERROR "docs-sync accepted stale or invalid results")
    endif()
endfunction()
sync(pass)
sync(pass --check)
file(READ "${WORK}/table.tex" rendered)
foreach(needle IN ITEMS [=[mac $\rightarrow$ pi & 2.5]=] [=[Measured & mac $\rightarrow$ pi]=] [=[p{0.4\linewidth}p{0.4\linewidth}]=] [=[pi & 2.5]=])
    string(FIND "${rendered}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "missing rendered table content: ${needle}")
    endif()
endforeach()

string(REPLACE "2.5" "7.25" record "${record}")
file(WRITE "${WORK}/docs/results/sample.json" "${record}")
sync(fail --check)
sync(pass)
sync(pass --check)
file(READ "${WORK}/table.tex" rendered)
string(FIND "${rendered}" "7.25" found)
if(found LESS 0)
    message(FATAL_ERROR "changed result was not regenerated")
endif()
foreach(bad IN ITEMS "layout={compact},columns={test|unknown}" "layout={compact},columns={test|latency},widths={0.4}" "layout={compact},columns={test|latency},widths={0.4|nan}" "layout={unknown},columns={test|latency}")
    file(WRITE "${WORK}/table.tex" "% results: sample [${bad}]\n% /results\n")
    sync(fail)
endforeach()

# A Windows checkout can give both the pages and their source snippets CRLF.
# Checking equivalent text must succeed without rewriting it, while a real
# source change must still be detected and regenerated in both formats.
set(sync_pages line-endings.md line-endings.tex)
set(source "// --8<-- [start:sample]\nint example = 1;\n// --8<-- [end:sample]\n")
file(WRITE "${WORK}/example.cpp" "${source}")
file(WRITE "${WORK}/line-endings.md" "# Example\n\n<!-- snippet: example.cpp#sample -->\n<!-- /snippet -->\n\n<!-- results: sample -->\n<!-- /results -->\n")
file(WRITE "${WORK}/line-endings.tex" "% snippet: example.cpp#sample\n% /snippet\n% results: sample\n% /results\n")
sync(pass)
foreach(input IN ITEMS line-endings.md line-endings.tex example.cpp docs/results/sample.json)
    file(READ "${WORK}/${input}" text)
    string(REPLACE "\n" "\r\n" text "${text}")
    file(WRITE "${WORK}/${input}" "${text}")
endforeach()
file(SHA256 "${WORK}/line-endings.md" before_check)
sync(pass --check)
file(SHA256 "${WORK}/line-endings.md" after_check)
if(NOT before_check STREQUAL after_check)
    message(FATAL_ERROR "checking CRLF text rewrote the page")
endif()
string(REPLACE "example = 1" "example = 2" source "${source}")
string(REPLACE "\n" "\r\n" source "${source}")
file(WRITE "${WORK}/example.cpp" "${source}")
sync(fail --check)
sync(pass)
sync(pass --check)
foreach(page IN LISTS sync_pages)
    file(READ "${WORK}/${page}" text)
    string(FIND "${text}" "int example = 2;" found)
    string(FIND "${text}" "\r" carriage_return)
    if(found LESS 0 OR NOT carriage_return LESS 0)
        message(FATAL_ERROR "CRLF source was not regenerated as LF text: ${page}")
    endif()
endforeach()
