# End-to-end test of the key and ledger commands of paglets-host:
#   cmake -DHOST=<paglets-host> -DDIR=<work directory> -P cli_ledger.cmake

if(NOT HOST OR NOT DIR)
    message(FATAL_ERROR "HOST and DIR are required")
endif()
file(REMOVE_RECURSE "${DIR}")
file(MAKE_DIRECTORY "${DIR}")
file(WRITE "${DIR}/pass" "test passphrase\n")
set(L "${DIR}/ledger")
set(P --passphrase-file "${DIR}/pass")

# Runs paglets-host; stores stdout in OUT and stderr in ERR.
# EXPECT_FAIL inverts the check.
function(host)
    cmake_parse_arguments(A "EXPECT_FAIL" "" "ARGS" ${ARGN})
    execute_process(COMMAND "${HOST}" ${A_ARGS} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(STRIP "${out}" out)
    if(A_EXPECT_FAIL)
        if(rc EQUAL 0)
            message(FATAL_ERROR "expected a failure: paglets-host ${A_ARGS}\n${out}")
        endif()
    elseif(NOT rc EQUAL 0)
        message(FATAL_ERROR "paglets-host ${A_ARGS} failed (${rc}):\n${out}\n${err}")
    endif()
    set(OUT "${out}" PARENT_SCOPE)
    set(ERR "${err}" PARENT_SCOPE)
endfunction()

function(expect text)
    string(FIND "${OUT}" "${text}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "expected '${text}' in:\n${OUT}")
    endif()
endfunction()

function(expect_not text)
    string(FIND "${OUT}" "${text}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "did not expect '${text}' in:\n${OUT}")
    endif()
endfunction()

function(expect_stderr text)
    string(FIND "${ERR}" "${text}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "expected '${text}' on stderr:\n${ERR}")
    endif()
endfunction()

function(expect_quiet)
    if(NOT "${ERR}" STREQUAL "")
        message(FATAL_ERROR "unexpected stderr:\n${ERR}")
    endif()
endfunction()

host(ARGS keys init --role admin --name alice --out "${DIR}/alice.key" ${P} --kdf interactive)
set(alice "${OUT}")
host(ARGS keys init --role host --name h1 --out "${DIR}/h1.key")
set(h1 "${OUT}")
host(ARGS keys init --role owner --name olga --out "${DIR}/olga.key" ${P} --kdf interactive)
host(EXPECT_FAIL ARGS keys init --role host --name again --out "${DIR}/h1.key")
host(ARGS keys show "${DIR}/alice.key")
expect("role:      admin")
expect("encrypted: yes")
expect("${alice}")

host(ARGS mesh create --name lab --ledger "${L}" --admin "${DIR}/alice.key" ${P})
expect_quiet()
host(EXPECT_FAIL ARGS mesh create --name lab --ledger "${L}" --admin "${DIR}/alice.key" ${P})

# Three admins default to two signatures for admin changes, but ordinary
# records still need one. A pending admin addition becomes effective only
# after a second admin co-signs that same record.
foreach(name bob charlie dora)
    host(ARGS keys init --role admin --name ${name} --out "${DIR}/${name}.key" ${P} --kdf interactive)
    set(${name} "${OUT}")
endforeach()
set(A --admin "${DIR}/alice.key" --admin "${DIR}/bob.key" --admin "${DIR}/charlie.key")
set(Q "${DIR}/quorum-default")
host(ARGS mesh create --name three --ledger "${Q}" ${A} ${P})
expect_quiet()
host(ARGS ledger show --ledger "${Q}")
expect("quorum:  2 for admin changes, 1 otherwise")
host(ARGS ledger admins --ledger "${Q}" --admin "${DIR}/alice.key" ${P} --add ${dora})
set(change "${OUT}")
expect_stderr("the record has no effect yet")
host(ARGS ledger show --ledger "${Q}")
expect_not("${dora}")
host(ARGS ledger enroll --ledger "${Q}" --admin "${DIR}/alice.key" ${P} host ${h1} h1)
expect_quiet()
host(ARGS ledger show --ledger "${Q}")
expect("${h1}")
host(ARGS ledger sign --ledger "${Q}" --admin "${DIR}/bob.key" ${P} ${change})
expect_quiet()
host(ARGS ledger show --ledger "${Q}")
expect("${dora}")

# Explicit quorums win, including a deliberate choice of one. Notes stay
# on stderr so mesh creation still prints only the mesh ID on stdout.
host(ARGS mesh create --name explicit --ledger "${DIR}/quorum-explicit" ${A} ${P}
          --admin-quorum 3 --quorum 2)
expect_quiet()
host(ARGS ledger show --ledger "${DIR}/quorum-explicit")
expect("quorum:  3 for admin changes, 2 otherwise")
host(ARGS mesh create --name one --ledger "${DIR}/quorum-one" ${A} ${P} --admin-quorum 1)
expect_stderr("any one admin can change the admin set")
expect_stderr("--admin-quorum 2 or more")
string(LENGTH "${OUT}" id_length)
if(NOT id_length EQUAL 64)
    message(FATAL_ERROR "mesh creation stdout is not a mesh ID: ${OUT}")
endif()
host(ARGS ledger show --ledger "${DIR}/quorum-one")
expect("quorum:  1 for admin changes, 1 otherwise")
host(ARGS mesh create --name two --ledger "${DIR}/quorum-two" ${P}
          --admin "${DIR}/alice.key" --admin "${DIR}/bob.key")
expect_stderr("any one admin can change the admin set")
host(ARGS ledger show --ledger "${DIR}/quorum-two")
expect("quorum:  1 for admin changes, 1 otherwise")
host(ARGS mesh create --name four --ledger "${DIR}/quorum-four" ${A} ${P} --admin "${DIR}/dora.key")
expect_quiet()
host(ARGS ledger show --ledger "${DIR}/quorum-four")
expect("quorum:  2 for admin changes, 1 otherwise")
host(ARGS mesh create --name two-explicit --ledger "${DIR}/quorum-two-explicit" ${P}
          --admin "${DIR}/alice.key" --admin "${DIR}/bob.key" --admin-quorum 2)
expect_quiet()
host(ARGS ledger show --ledger "${DIR}/quorum-two-explicit")
expect("quorum:  2 for admin changes, 1 otherwise")

# Invalid thresholds and duplicate public keys must not create a ledger.
foreach(flag --admin-quorum --quorum)
    foreach(n 0 4)
        host(EXPECT_FAIL ARGS mesh create --name invalid --ledger "${DIR}/quorum-invalid"
             ${A} ${P} ${flag} ${n})
        if(EXISTS "${DIR}/quorum-invalid")
            message(FATAL_ERROR "invalid quorum created a ledger")
        endif()
    endforeach()
endforeach()
file(COPY_FILE "${DIR}/alice.key" "${DIR}/alice-copy.key")
host(EXPECT_FAIL ARGS mesh create --name duplicate --ledger "${DIR}/quorum-duplicate" ${P}
     --admin "${DIR}/alice.key" --admin "${DIR}/alice-copy.key" --admin "${DIR}/bob.key")
if(EXISTS "${DIR}/quorum-duplicate")
    message(FATAL_ERROR "duplicate admin keys created a ledger")
endif()

host(ARGS ledger request --ledger "${L}" --key "${DIR}/h1.key" --label linux)
string(SUBSTRING "${OUT}" 0 12 host_request)
host(ARGS ledger request --ledger "${L}" --key "${DIR}/olga.key" ${P})
string(SUBSTRING "${OUT}" 0 12 owner_request)
host(ARGS ledger show --ledger "${L}")
expect("mesh:    lab")
expect("host   h1  ${h1}")
expect("owner  olga")

# Only admins decide.
host(EXPECT_FAIL ARGS ledger approve --ledger "${L}" --admin "${DIR}/olga.key" ${P} ${host_request})
host(ARGS ledger approve --ledger "${L}" --admin "${DIR}/alice.key" ${P} ${host_request})
host(ARGS ledger deny --ledger "${L}" --admin "${DIR}/alice.key" ${P} ${owner_request} --reason unknown)
host(ARGS ledger show --ledger "${L}")
expect("${h1}  h1  linux")
expect_not("owner  olga")

host(ARGS ledger revoke --ledger "${L}" --admin "${DIR}/alice.key" ${P} ${h1} --reason retired)
host(ARGS ledger show --ledger "${L}")
expect("key    ${h1}")
expect_not("${h1}  h1  linux")

# Policy: a rule, listed by show; the audit log is empty without hosts at work.
host(ARGS ledger rule --ledger "${L}" --admin "${DIR}/alice.key" ${P} --name "staff docs" --decision ask
          --service files --op read --group staff --root data --path "docs/**")
host(EXPECT_FAIL ARGS ledger rule --ledger "${L}" --admin "${DIR}/alice.key" ${P} --name bad --decision maybe
          --service files --op read)
host(ARGS ledger show --ledger "${L}")
expect("ask  files  read  staff docs")
host(ARGS ledger audit --ledger "${L}")

# Module trust: a signer signs a module, an admin trusts the signer; signer keys are not enrolled.
host(ARGS keys init --role signer --name sam --out "${DIR}/sam.key" ${P} --kdf interactive)
set(sam "${OUT}")
set(module "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
set(bad_module "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100")
host(ARGS ledger sign-module --ledger "${L}" --key "${DIR}/sam.key" ${P} --name calc --version 1.0 ${module})
host(EXPECT_FAIL ARGS ledger request --ledger "${L}" --key "${DIR}/sam.key" ${P})
host(EXPECT_FAIL ARGS ledger sign-module --ledger "${L}" --key "${DIR}/sam.key" ${P} --name calc not-a-module)
host(ARGS ledger trust --ledger "${L}" --admin "${DIR}/alice.key" ${P} --name "lab apps" --class roaming
          --class resident --signer ${sam})
host(EXPECT_FAIL ARGS ledger trust --ledger "${L}" --admin "${DIR}/alice.key" ${P} --name bad --class admin
          --signer ${sam})
host(EXPECT_FAIL ARGS ledger trust --ledger "${L}" --admin "${DIR}/olga.key" ${P} --name mine --class system
          --module ${module})
host(ARGS ledger module-policy --ledger "${L}" --admin "${DIR}/alice.key" ${P} trusted)
host(ARGS ledger revoke --ledger "${L}" --admin "${DIR}/alice.key" ${P} --module ${bad_module} --reason vulnerable)
host(ARGS ledger rule --ledger "${L}" --admin "${DIR}/alice.key" ${P} --name "signed tools" --decision allow
          --service server-info --op summary --signer ${sam})
host(ARGS ledger residency --ledger "${L}" --admin "${DIR}/alice.key" ${P} clinic hosts --host-label site)
host(ARGS ledger residency --ledger "${L}" --admin "${DIR}/alice.key" ${P} vault host-only)
host(EXPECT_FAIL ARGS ledger residency --ledger "${L}" --admin "${DIR}/alice.key" ${P} vault hosts)
host(EXPECT_FAIL ARGS ledger residency --ledger "${L}" --admin "${DIR}/alice.key" ${P} vault elsewhere)

# Host identities outrank display names; shorthand must identify one host.
set(R "${DIR}/address-ledger")
host(ARGS mesh create --name addresses --ledger "${R}" --admin "${DIR}/alice.key" ${P})
foreach(name address-a address-b address-absent address-duplicate)
    host(ARGS keys init --role host --name ${name} --out "${DIR}/${name}.key")
    set(${name} "${OUT}")
endforeach()
if("${address-a}" STRLESS "${address-b}")
    set(target "${address-a}")
    set(alias "${address-b}")
else()
    set(target "${address-b}")
    set(alias "${address-a}")
endif()
host(ARGS ledger enroll --ledger "${R}" --admin "${DIR}/alice.key" ${P} host ${target} address-target)
host(ARGS ledger enroll --ledger "${R}" --admin "${DIR}/alice.key" ${P} host ${alias} ${target})
host(ARGS ledger residency --ledger "${R}" --admin "${DIR}/alice.key" ${P} canonical hosts ${target})
host(ARGS ledger show --ledger "${R}")
expect("root canonical  hosts  address-target")
# The absent host's canonical ID is only a name of another enrolled host.
host(ARGS ledger enroll --ledger "${R}" --admin "${DIR}/alice.key" ${P} host ${address-duplicate} ${address-absent})
host(EXPECT_FAIL ARGS ledger residency --ledger "${R}" --admin "${DIR}/alice.key" ${P} missing hosts ${address-absent})
expect_stderr("no enrolled host")
host(ARGS ledger enroll --ledger "${R}" --admin "${DIR}/alice.key" ${P} host ${address-duplicate} address-target)
host(EXPECT_FAIL ARGS ledger residency --ledger "${R}" --admin "${DIR}/alice.key" ${P} ambiguous hosts address-target)
expect_stderr("ambiguous host address")
host(ARGS ledger show --ledger "${R}")
expect_not("root missing")
expect_not("root ambiguous")

host(ARGS ledger show --ledger "${L}")
expect("root clinic  hosts  label site")
expect("root vault  host-only")
expect("module trust (roaming modules: trusted)")
expect("roaming,resident  lab apps  signer ")
expect("calc 1.0  signer ")
expect("module ${bad_module}")
expect("allow  server-info  summary  signed tools")
