if(NOT HOST OR NOT DIR)
    message(FATAL_ERROR "HOST and DIR are required")
endif()

if(DRIVER)
    function(fail text)
        file(WRITE "${DIR}/stop" "")
        message(FATAL_ERROR "${text}")
    endfunction()
    foreach(i RANGE 1 100)
        if(EXISTS "${DIR}/url")
            file(READ "${DIR}/url" URL)
            if(NOT "${URL}" STREQUAL "")
                break()
            endif()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
    endforeach()
    if(NOT URL)
        fail("fixture did not publish its URL")
    endif()
    function(check mode expected)
        file(WRITE "${DIR}/mode" "${mode}")
        execute_process(COMMAND "${HOST}" remote ${ARGN} --connect "${URL}" --key "${DIR}/owner.key"
                                --ledger "${DIR}/ledger" --passphrase-file "${DIR}/pass"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
        if(expected STREQUAL "bad")
            if(NOT "${rc}" STREQUAL "1" OR NOT err MATCHES "malformed answer" OR NOT "${out}" STREQUAL "")
                fail("${mode}: expected a controlled malformed-answer error with no partial stdout; got ${rc}:\n${out}\n${err}")
            endif()
        elseif(expected STREQUAL "refused")
            if(NOT "${rc}" STREQUAL "1" OR NOT err MATCHES "fixture refusal" OR NOT "${out}" STREQUAL "")
                fail("normal refusal changed: ${rc}: ${out} ${err}")
            endif()
        elseif(expected STREQUAL "pending")
            if(NOT "${rc}" STREQUAL "1" OR NOT err MATCHES "has not ended after 120 s" OR NOT "${out}" STREQUAL "")
                fail("pending dispatch changed: ${rc}: ${out} ${err}")
            endif()
        elseif(expected STREQUAL "move-failed")
            if(NOT "${rc}" STREQUAL "1" OR NOT err MATCHES "the move failed, the paglet stays: fixture move refused"
               OR NOT "${out}" STREQUAL "")
                fail("failed dispatch changed: ${rc}: ${out} ${err}")
            endif()
        elseif(NOT "${rc}" STREQUAL "0")
            fail("${mode}: valid reply refused (${rc}): ${out} ${err}")
        endif()
        file(APPEND "${DIR}/checks.log" "${mode}: ${expected}\n")
    endfunction()
    # Invalid job IDs must never send a cancellation for a numeric prefix.
    file(WRITE "${DIR}/mode" "jobs-cancel")
    file(READ "${DIR}/requests.log" before)
    foreach(value "1junk" "1.5" "1e3" "+1" " 1" "1 " "" 0 -1 9223372036854775808)
        execute_process(COMMAND "${HOST}" remote jobs cancel "${value}" --connect "${URL}"
                                --key "${DIR}/owner.key" --ledger "${DIR}/ledger"
                                --passphrase-file "${DIR}/pass"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
        if(NOT "${rc}" STREQUAL "2" OR NOT err MATCHES "usage:" OR NOT "${out}" STREQUAL "")
            fail("invalid job ID '${value}' was not refused: ${rc}: ${out} ${err}")
        endif()
    endforeach()
    file(READ "${DIR}/requests.log" after)
    if(NOT "${before}" STREQUAL "${after}")
        fail("an invalid job ID reached the authenticated host")
    endif()
    function(argument_status expected)
        execute_process(COMMAND "${HOST}" ${ARGN}
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
        if(NOT "${rc}" STREQUAL "${expected}" OR NOT "${out}" STREQUAL "")
            fail("${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
        endif()
        if(expected EQUAL 2 AND NOT err MATCHES "usage:")
            fail("${ARGN}: invalid argument did not produce usage")
        endif()
        file(APPEND "${DIR}/integer-arguments.log" "${ARGN}: ${rc}\n")
    endfunction()
    set(missing "${DIR}/missing")
    foreach(value "1junk" "1.5" "1e3" "+1" " 1" "1 " "" -1 4294967296 18446744073709551616)
        argument_status(2 run "${missing}.wasm" --threads "${value}" --in-process)
    endforeach()
    foreach(value 0 1)
        argument_status(1 run "${missing}.wasm" --threads "${value}" --in-process)
    endforeach()
    if(REFLECTION)
        set(serve serve --key "${missing}.key" --ledger "${missing}-ledger" --state "${missing}-state")
        foreach(option --threads --slots --beacon-port --memory-mb)
            foreach(value "1junk" "1.5" "1e3" "+1" " 1" "1 " "" -1 18446744073709551616)
                argument_status(2 ${serve} ${option} "${value}")
            endforeach()
        endforeach()
        argument_status(2 ${serve} --threads 4294967296)
        argument_status(2 ${serve} --slots 0)
        argument_status(2 ${serve} --slots 9223372036854775808)
        foreach(value 0 65536)
            argument_status(2 ${serve} --beacon-port "${value}")
        endforeach()
        foreach(value 4097)
            argument_status(2 ${serve} --memory-mb "${value}")
        endforeach()
        foreach(value "1junk" "1.5" "1e3" "+1" " 1" "1 " "" -1 65536 18446744073709551616)
            argument_status(2 ${serve} --listen "127.0.0.1:${value}")
        endforeach()
        argument_status(2 ${serve} --listen localhost)
        foreach(value 0 1 65535)
            argument_status(1 ${serve} --listen "127.0.0.1:${value}")
        endforeach()
        foreach(value 0 4294967295)
            argument_status(1 ${serve} --threads "${value}")
        endforeach()
        foreach(value 1 9223372036854775807)
            argument_status(1 ${serve} --slots "${value}")
        endforeach()
        foreach(value 1 65535)
            argument_status(1 ${serve} --beacon-port "${value}")
        endforeach()
        foreach(value 0 1 4096)
            argument_status(1 ${serve} --memory-mb "${value}")
        endforeach()
        # Exercise a real free-port listener and the supported zero-lane clamp.
        file(WRITE "${DIR}/serve-stop" "")
        execute_process(COMMAND "${HOST}" serve --key "${DIR}/host.key" --ledger "${DIR}/ledger"
                                --state "${DIR}/serve-state" --listen 127.0.0.1:0 --threads 0
                                --slots 1 --no-beacon --no-aot --stop-file "${DIR}/serve-stop"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
        if(NOT "${rc}" STREQUAL "0" OR NOT out MATCHES "url  https://127.0.0.1:[1-9][0-9]*")
            fail("valid zero-thread/free-port host failed: ${rc}: ${out} ${err}")
        endif()
        file(APPEND "${DIR}/integer-arguments.log" "real serve: ${out}\n")
    endif()
    check(location-valid good locate demo)
    check(location-missing bad locate demo)
    foreach(mode location-type location-size location-moves)
        check(${mode} bad locate demo)
    endforeach()
    check(location-future good locate demo)
    check(location-valid good pin demo)
    # Check the milliseconds received by the authenticated host. The host's
    # own clamp must not hide overflow in the CLI's minutes conversion.
    file(WRITE "${DIR}/pin-durations.log" "")
    check(location-duration good pin demo)
    check(location-duration good pin demo --minutes 1)
    check(location-duration good pin demo --minutes 1440)
    check(location-duration good pin demo --minutes 1441)
    check(location-duration good pin demo --minutes 9223372036854775807)
    file(STRINGS "${DIR}/pin-durations.log" durations)
    if(NOT "${durations}" STREQUAL "600000;60000;86400000;86400000;86400000")
        fail("pin durations on the wire overflowed or were not capped: ${durations}")
    endif()
    foreach(option --minutes --hours --max-duration --admin-quorum --quorum --priority)
        foreach(value "1junk" "1.5" "1e3" "+1" " 1" "1 " "9223372036854775808")
            execute_process(COMMAND "${HOST}" remote pin demo ${option} "${value}"
                            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
            if(NOT "${rc}" STREQUAL "2" OR NOT err MATCHES "usage:" OR NOT "${out}" STREQUAL "")
                fail("integer ${option} '${value}' was not rejected before opening a session: ${rc}: ${out} ${err}")
            endif()
        endforeach()
    endforeach()
    file(READ "${DIR}/duration-request" request_id)
    execute_process(COMMAND "${HOST}" ledger approve "${request_id}" --ledger "${DIR}/ledger"
                            --admin "${DIR}/admin.key" --passphrase-file "${DIR}/pass"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${rc}" STREQUAL "0" OR err MATCHES "no effect")
        fail("large-duration approval failed: ${rc}: ${out} ${err}")
    endif()
    file(WRITE "${DIR}/verify-duration-grant" "")
    check(location-pin bad pin demo)
    check(location-until bad pin demo)
    check(location-valid good unpin demo)
    check(location-released bad unpin demo)
    foreach(mode not-map missing-ok bad-ok)
        check(${mode} bad locate demo)
    endforeach()
    check(refused refused locate demo)
    check(hosts-valid good hosts)
    foreach(mode hosts-missing hosts-type hosts-row hosts-key hosts-name hosts-relays)
        check(${mode} bad hosts)
    endforeach()
    check(pins-valid good pins)
    foreach(mode pins-missing pins-type pins-row pins-short pins-field-0 pins-field-1 pins-field-2 pins-field-3 pins-field-4)
        check(${mode} bad pins)
    endforeach()
    check(push-valid good push)
    check(push-type bad push)
    check(push-row bad push)
    check(moves-valid good moves)
    check(moves-missing bad moves)
    check(moves-type bad moves)
    check(call-valid good call demo run)
    foreach(mode call-missing call-type call-range call-payload)
        check(${mode} bad call demo run)
    endforeach()
    check(status-valid good status)
    foreach(mode status-key status-type status-row status-field status-system)
        check(${mode} bad status)
    endforeach()
    check(records-valid good pull)
    foreach(mode records-missing records-type records-row)
        check(${mode} bad pull)
    endforeach()
    check(modules-valid good modules)
    foreach(mode modules-type modules-row modules-names modules-interface)
        check(${mode} bad modules)
    endforeach()
    check(describe-valid good describe demo)
    check(describe-valid good describe demo --json)
    foreach(mode describe-type describe-json describe-shape describe-schema)
        check(${mode} bad describe demo)
        check(${mode} bad describe demo --json)
    endforeach()
    check(jobs-valid good jobs)
    check(jobs-empty good jobs)
    check(jobs-type bad jobs)
    check(jobs-row bad jobs)
    check(jobs-cancel good jobs cancel 1)
    check(jobs-cancel-type bad jobs cancel 1)
    check(dispatch-valid good dispatch demo there)
    check(dispatch-failed move-failed dispatch demo there)
    check(dispatch-pending pending dispatch demo there)
    check(empty good dispatch demo there)
    check(dispatch-type bad dispatch demo there)
    check(dispatch-host bad dispatch demo there)
    check(dispatch-false-pending good dispatch demo there)
    check(dispatch-bad-pending bad dispatch demo there)
    check(dispatch-conflict bad dispatch demo there)
    if(REFLECTION)
        check(check-valid good zombies check demo)
        foreach(mode check-missing check-type check-row)
            check(${mode} bad zombies check demo)
        endforeach()
        check(landscape-valid good landscape)
        check(landscape-row bad landscape)
        check(landscape-body bad landscape)
        check(groups-valid good zombies list)
        check(groups-row bad zombies list)
        check(groups-body bad zombies list)
        check(traces-valid good zombies traces demo)
        check(traces-row bad zombies traces demo)
        check(traces-body bad zombies traces demo)
        check(slots-valid good slots)
        check(slots-type bad slots)
    endif()
    # Inspect the wire value echoed by the authenticated fixture, not elapsed
    # wall time. Replay the actual web-generated argv on every platform.
    file(WRITE "${DIR}/mode" "call-timeout")
    function(timeout expected)
        execute_process(COMMAND "${HOST}" remote call demo run ${ARGN} --connect "${URL}" --key "${DIR}/owner.key"
                                --ledger "${DIR}/ledger" --passphrase-file "${DIR}/pass"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
        string(STRIP "${out}" out)
        if(NOT "${rc}" STREQUAL "0" OR NOT "${out}" STREQUAL "${expected}")
            fail("timeout ${ARGN}: expected ${expected} ms; got ${rc}: ${out} ${err}")
        endif()
        file(APPEND "${DIR}/timeouts.log" "CLI ${ARGN}: ${out} ms\n")
    endfunction()
    timeout(30000)
    timeout(30000 --timeout 30)
    timeout(37500 --timeout 37.5)
    timeout(30125 --timeout 30.125)
    timeout(100 --timeout 0.1)
    timeout(101 --timeout 0.101)
    timeout(120000 --timeout 120)
    timeout(120000 --timeout 120.000)
    timeout(30100 --timeout 00030.100)
    foreach(value "" 0 -1 0.099 120.001 121 1.0001 1. .1 +1 1e1 nan inf 30junk 1.2.3 99999999999999999999999 " 1")
        execute_process(COMMAND "${HOST}" remote call demo run --timeout "${value}"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
        if(NOT "${rc}" STREQUAL "1" OR NOT err MATCHES "timeout must be" OR NOT "${out}" STREQUAL "")
            fail("invalid timeout '${value}' was not rejected before connecting: ${rc}: ${out} ${err}")
        endif()
        file(APPEND "${DIR}/timeouts.log" "invalid '${value}': rejected\n")
    endforeach()
    if(REFLECTION)
        file(READ "${DIR}/web-timeouts.json" responses)
        set(milliseconds 30000 30000 37500 30125 100 101 120000 100 120000 100 30000)
        set(seconds default default 37.5 30.125 0.1 0.101 120 0.1 120 0.1 default)
        foreach(i RANGE 0 10)
            list(GET milliseconds ${i} expected)
            list(GET seconds ${i} option)
            string(JSON status GET "${responses}" ${i} status)
            string(JSON reply GET "${responses}" ${i} reply)
            string(JSON shell GET "${responses}" ${i} shell)
            if(NOT "${status}" STREQUAL "0" OR NOT "${reply}" STREQUAL "${expected}")
                fail("web timeout ${i}: expected ${expected} ms, got ${status}: ${reply}")
            endif()
            if(option STREQUAL "default")
                if(shell MATCHES "--timeout")
                    fail("default web timeout unnecessarily changes its command: ${shell}")
                endif()
            elseif(NOT shell MATCHES " --timeout ${option}$")
                fail("web timeout ${i}: missing effective timeout ${option}: ${shell}")
            endif()
            separate_arguments(command UNIX_COMMAND "${shell}")
            list(POP_FRONT command program)
            if(NOT program STREQUAL "paglets-host")
                fail("unexpected generated program: ${program}")
            endif()
            execute_process(COMMAND "${HOST}" ${command}
                            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
            string(STRIP "${out}" out)
            if(NOT "${rc}" STREQUAL "0" OR NOT "${out}" STREQUAL "${expected}")
                fail("web command replay ${i} lost its timeout: ${rc}: ${out} ${err}")
            endif()
            file(APPEND "${DIR}/timeouts.log" "web+CLI replay ${i}: ${out} ms\n")
        endforeach()
    endif()
    if(REFLECTION)
        file(READ "${DIR}/web-dispatches.json" responses)
        set(pending_values OFF OFF ON OFF OFF ON)
        set(moved_values ON ON OFF OFF OFF OFF)
        foreach(i RANGE 0 5)
            list(GET pending_values ${i} expected_pending)
            list(GET moved_values ${i} expected_moved)
            string(JSON mode GET "${responses}" ${i} mode)
            string(JSON http GET "${responses}" ${i} http)
            string(JSON pending GET "${responses}" ${i} body pending)
            string(JSON moved GET "${responses}" ${i} body moved)
            if(NOT "${http}" STREQUAL "200" OR NOT "${pending}" STREQUAL "${expected_pending}"
               OR NOT "${moved}" STREQUAL "${expected_moved}")
                fail("web ${mode}: expected pending=${expected_pending}, moved=${expected_moved}; got HTTP ${http}, pending=${pending}, moved=${moved}")
            endif()
            if(i EQUAL 0 OR i EQUAL 1)
                string(JSON destination GET "${responses}" ${i} body to)
                string(LENGTH "${destination}" digits)
                if(NOT digits EQUAL 64)
                    fail("web ${mode} lost its destination host ID")
                endif()
            elseif(i EQUAL 3 OR i EQUAL 4)
                string(JSON reason GET "${responses}" ${i} body reason)
                if(NOT reason STREQUAL "fixture move refused")
                    fail("web failed move lost its reason")
                endif()
            endif()
            file(APPEND "${DIR}/web-dispatches.log" "${mode}: HTTP ${http}, pending=${pending}, moved=${moved}\n")
        endforeach()
        string(JSON http GET "${responses}" 6 http)
        string(JSON error GET "${responses}" 6 body error)
        if(NOT "${http}" STREQUAL "422" OR NOT error STREQUAL "malformed answer")
            fail("web malformed dispatch was not refused: ${http}: ${error}")
        endif()
        file(APPEND "${DIR}/web-dispatches.log" "malformed: HTTP422, malformed answer\n")
    endif()
    file(WRITE "${DIR}/stop" "")
    return()
endif()

if(NOT FIXTURE)
    message(FATAL_ERROR "FIXTURE is required")
endif()
file(REMOVE_RECURSE "${DIR}")
file(MAKE_DIRECTORY "${DIR}")
file(WRITE "${DIR}/pass" "fixture passphrase\n")
function(host)
    execute_process(COMMAND "${HOST}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "fixture setup failed: ${out} ${err}")
    endif()
    string(STRIP "${out}" out)
    set(OUT "${out}" PARENT_SCOPE)
endfunction()
set(P --passphrase-file "${DIR}/pass")
host(keys init --role admin --name admin --out "${DIR}/admin.key" ${P} --kdf interactive)
host(keys init --role owner --name owner --out "${DIR}/owner.key" ${P} --kdf interactive)
set(owner "${OUT}")
host(keys init --role host --name fixture --out "${DIR}/host.key")
set(key "${OUT}")
host(mesh create --name fixture --ledger "${DIR}/ledger" --admin "${DIR}/admin.key" ${P})
host(ledger enroll --ledger "${DIR}/ledger" --admin "${DIR}/admin.key" ${P} owner ${owner} owner)
host(ledger enroll --ledger "${DIR}/ledger" --admin "${DIR}/admin.key" ${P} host ${key} fixture)
execute_process(COMMAND "${FIXTURE}" "${DIR}"
                COMMAND "${CMAKE_COMMAND}" -DHOST=${HOST} -DDIR=${DIR} -DDRIVER=ON -DREFLECTION=${REFLECTION}
                        -P "${CMAKE_CURRENT_LIST_FILE}"
                RESULTS_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 240)
foreach(status IN LISTS rc)
    if(NOT "${status}" STREQUAL "0")
        message(FATAL_ERROR "CLI reply run failed (${rc}):\n${out}\n${err}")
    endif()
endforeach()
