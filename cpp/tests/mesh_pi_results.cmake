cmake_minimum_required(VERSION 3.19)
if(NOT JQ OR NOT FILTER OR NOT WORK)
    message(FATAL_ERROR "JQ, FILTER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(valid "{\"compute_ms\":4321,\"convert_ms\":147,\"chunks_done\":2,\"chunks_aot\":1,\"hosts\":[\"mac\",\"pi\"]}")

function(record input computed ended expect_success)
    file(WRITE "${WORK}/status.json" "${input}")
    execute_process(COMMAND "${JQ}" --argjson hex_bytes 1000 --argjson decimal_bytes 1200
        --argjson hold_ms 75 --argjson began 100 --argjson computed "${computed}" --argjson ended "${ended}"
        -f "${FILTER}" "${WORK}/status.json"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expect_success AND NOT rc EQUAL 0)
        message(FATAL_ERROR "valid Pi status failed: ${err}")
    elseif(NOT expect_success AND rc EQUAL 0)
        message(FATAL_ERROR "invalid Pi metrics accepted: ${input}: ${out}")
    endif()
    set(OUT "${out}" PARENT_SCOPE)
endfunction()

function(expect_metric name expected unit)
    string(JSON count LENGTH "${OUT}")
    math(EXPR last "${count} - 1")
    set(found 0)
    foreach(index RANGE 0 ${last})
        string(JSON label GET "${OUT}" ${index} name)
        if(label STREQUAL name)
            string(JSON actual GET "${OUT}" ${index} value)
            string(JSON actual_unit GET "${OUT}" ${index} unit)
            if(NOT actual STREQUAL expected OR NOT actual_unit STREQUAL unit)
                message(FATAL_ERROR "wrong ${name}: ${actual} ${actual_unit}")
            endif()
            math(EXPR found "${found} + 1")
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "expected exactly one ${name}: ${OUT}")
    endif()
endfunction()

record("${valid}" 104 104 TRUE)
expect_metric("successful hex jobs: reported elapsed time (sum)" "4321" "ms")
expect_metric("successful conversion job: reported elapsed time" "147" "ms")
expect_metric("hex completion first observed by polling" "4" "s")
expect_metric("end first observed after hex completion" "0" "s")
expect_metric("chunks compiled ahead of time" "1" "")
expect_metric("hosts that computed chunks" "mac, pi" "")
foreach(old_label "computing the hex digits" "converting into decimal digits")
    string(FIND "${OUT}" "${old_label}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "poll observation still claims a phase duration: ${OUT}")
    endif()
endforeach()
foreach(field compute_ms convert_ms chunks_done chunks_aot)
    foreach(bad "null" "-1" "0.5" "\"unknown\"")
        string(JSON invalid SET "${valid}" "${field}" "${bad}")
        record("${invalid}" 104 104 FALSE)
    endforeach()
endforeach()
string(JSON invalid REMOVE "${valid}" compute_ms)
record("${invalid}" 104 104 FALSE)
string(JSON invalid SET "${valid}" chunks_aot 3)
record("${invalid}" 104 104 FALSE)
string(JSON invalid SET "${valid}" hosts "[1]")
record("${invalid}" 104 104 FALSE)
record("${valid}" 99 104 FALSE)
record("${valid}" 104 103 FALSE)
message(STATUS "Pi job durations and polling observations remain distinct; invalid metadata is refused")
