# Writes the web UI's files as raw string literals into a C++ source file:
#   cmake -DOUT=<file.cpp> -DASSETS=<dir> -P embed_assets.cmake
# (index.html, app.css and app.js become index_html, app_css and app_js).

set(content "// Generated by web/cmake/embed_assets.cmake from web/assets. Do not edit.\n\n")
string(APPEND content "#include \"app.hpp\"\n\nnamespace paglets::webapp {\n\n")
foreach(pair "index_html=index.html" "app_css=app.css" "app_js=app.js")
    string(REPLACE "=" ";" parts "${pair}")
    list(GET parts 0 symbol)
    list(GET parts 1 file)
    file(READ "${ASSETS}/${file}" text)
    string(FIND "${text}" ")PAGLETSWEB\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${file} contains the raw string delimiter")
    endif()
    string(APPEND content "const std::string_view ${symbol} = R\"PAGLETSWEB(${text})PAGLETSWEB\";\n\n")
endforeach()
string(APPEND content "}  // namespace paglets::webapp\n")
file(WRITE "${OUT}.tmp" "${content}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
