{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64, Homebrew GCC 16",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "linux-gcc16",
      "displayName": "Linux (x86-64 or arm64), GCC 16",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "linux-host-only",
      "displayName": "Linux, any C++23 compiler, no reflection, prebuilt guests",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "PAGLETS_BUILD_GUESTS": "OFF",
        "PAGLETS_ENABLE_REFLECTION": "OFF"
      }
    },
    {
      "name": "windows-mingw-gcc16",
      "displayName": "Windows x86-64, MinGW-w64 GCC 16 (MSYS2 UCRT64)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "macos-arm64-asan",
      "displayName": "macOS arm64, GCC 16, ASan + UBSan",
      "inherits": "macos-arm64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "PAGLETS_SANITIZE": "ON" }
    },
    {
      "name": "linux-gcc16-asan",
      "displayName": "Linux, GCC 16, ASan + UBSan",
      "inherits": "linux-gcc16",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "PAGLETS_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "linux-gcc16", "configurePreset": "linux-gcc16" },
    { "name": "linux-host-only", "configurePreset": "linux-host-only" },
    { "name": "windows-mingw-gcc16", "configurePreset": "windows-mingw-gcc16" },
    { "name": "macos-arm64-asan", "configurePreset": "macos-arm64-asan" },
    { "name": "linux-gcc16-asan", "configurePreset": "linux-gcc16-asan" }
  ],
  "testPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc16", "configurePreset": "linux-gcc16", "output": { "outputOnFailure": true } },
    { "name": "linux-host-only", "configurePreset": "linux-host-only", "output": { "outputOnFailure": true } },
    { "name": "windows-mingw-gcc16", "configurePreset": "windows-mingw-gcc16", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64-asan", "configurePreset": "macos-arm64-asan", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc16-asan", "configurePreset": "linux-gcc16-asan", "output": { "outputOnFailure": true } }
  ]
}
